# performance-enum-size and the padding analyzer are disabled repository wide
# because every declaration they flag is pinned by a contract that cannot be
# changed without breaking already published artifacts:
#   - the macro_sim_* enums in native/include/macro_sim/c_api.h, and the
#     matching macro_sim::ErrorCode underlying type, are part of the C ABI
#     consumed by the cp312-abi3 wheel and by the packaged desktop client;
#   - macro_sim::simulation::M4Capability is a 64 bit mask whose width is
#     shared with the MACRO_SIM_M4_CAPABILITY_* macros in c_api.h;
#   - M5PolicyState and M6Rules field order is pinned by the M5 contract lock
#     and by checkpoint serialization.
# Every other bugprone/performance/portability check stays warnings-as-errors.
Checks: >
  bugprone-*,
  performance-*,
  portability-*,
  -bugprone-easily-swappable-parameters,
  -performance-enum-size,
  -clang-analyzer-optin.performance.Padding
WarningsAsErrors: '*'
HeaderFilterRegex: 'native/(include|src)/.*'
FormatStyle: file
