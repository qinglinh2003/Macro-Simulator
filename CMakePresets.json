{
  "version": 6,
  "cmakeMinimumRequired": {
    "major": 3,
    "minor": 26,
    "patch": 0
  },
  "configurePresets": [
    {
      "name": "m1-base",
      "hidden": true,
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/build/native/${presetName}",
      "cacheVariables": {
        "CMAKE_CXX_COMPILER_LAUNCHER": "ccache",
        "CMAKE_EXPORT_COMPILE_COMMANDS": "ON",
        "MACRO_SIM_BUILD_BENCHMARKS": "ON",
        "MACRO_SIM_BUILD_PYTHON": "ON",
        "MACRO_SIM_BUILD_TESTS": "ON",
        "MACRO_SIM_WARNINGS_AS_ERRORS": "ON"
      }
    },
    {
      "name": "m1-debug",
      "inherits": "m1-base",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug"
      }
    },
    {
      "name": "m1-release",
      "inherits": "m1-base",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release",
        "MACRO_SIM_IPO": "ON"
      }
    },
    {
      "name": "m1-asan",
      "inherits": "m1-debug",
      "cacheVariables": {
        "MACRO_SIM_SANITIZERS": "address,undefined"
      }
    },
    {
      "name": "m1-tsan",
      "inherits": "m1-debug",
      "cacheVariables": {
        "MACRO_SIM_SANITIZERS": "thread"
      }
    },
    {
      "name": "m1-coverage",
      "inherits": "m1-debug",
      "cacheVariables": {
        "MACRO_SIM_COVERAGE": "ON"
      }
    },
    {
      "name": "m1-benchmark",
      "inherits": "m1-release",
      "cacheVariables": {
        "MACRO_SIM_BUILD_TESTS": "OFF"
      }
    },
    {
      "name": "m2-debug",
      "inherits": "m1-debug"
    },
