{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://macro-simulator.local/schemas/m0/gate-manifest.schema.json",
  "title": "M0 gate manifest",
  "type": "object",
  "required": ["schema_version", "oracle_commit", "gates"],
  "properties": {
    "schema_version": {
      "const": "m0-gate-manifest-v1"
    },
    "oracle_commit": {
      "type": "string",
      "pattern": "^[0-9a-f]{40}$"
    },
    "gates": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/gate"
      }
    }
  },
  "additionalProperties": false,
  "$defs": {
    "gate": {
      "type": "object",
      "required": [
        "id",
        "class",
        "command",
        "cwd",
        "dependencies",
        "timeout_seconds",
        "owner"
      ],
      "properties": {
        "id": {
          "type": "string"
        },
        "class": {
          "enum": ["pr", "nightly", "milestone", "release"]
        },
        "command": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "cwd": {
          "type": "string"
        },
        "dependencies": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "uniqueItems": true
        },
        "timeout_seconds": {
          "type": "integer",
          "minimum": 1
        },
        "owner": {
          "type": "string",
          "minLength": 1
        },
        "artifacts": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "fixture_ids": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "platform_profiles": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "process_count": {
          "type": "integer",
          "minimum": 1
        },
        "thread_count": {
          "type": "integer",
          "minimum": 1
        },
        "repetitions": {
          "type": "integer",
          "minimum": 1
        },
        "seeds": {
          "type": "array",
          "items": {
            "type": "integer",
            "minimum": 0
          }
        },
        "threshold_ref": {
          "type": ["string", "null"]
        }
      },
      "additionalProperties": false
    }
  }
}
