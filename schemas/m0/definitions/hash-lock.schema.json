{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://macro-simulator.local/schemas/m0/hash-lock.schema.json",
  "title": "M0 contract hash lock",
  "type": "object",
  "required": [
    "schema_version",
    "oracle_commit",
    "generator_version",
    "artifacts",
    "aggregate_sha256"
  ],
  "properties": {
    "schema_version": {
      "const": "m0-hash-lock-v1"
    },
    "oracle_commit": {
      "type": "string",
      "pattern": "^[0-9a-f]{40}$"
    },
    "generator_version": {
      "type": "string"
    },
    "artifacts": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["path", "sha256", "byte_count"],
        "properties": {
          "path": {
            "type": "string"
          },
          "sha256": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$"
          },
          "byte_count": {
            "type": "integer",
            "minimum": 0
          },
          "id_count": {
            "type": ["integer", "null"],
            "minimum": 0
          }
        },
        "additionalProperties": false
      }
    },
    "aggregate_sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    }
  },
  "additionalProperties": false
}
