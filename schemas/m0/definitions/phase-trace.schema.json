{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://macro-simulator.local/schemas/m0/phase-trace.schema.json",
  "title": "M0 Python oracle phase trace record",
  "type": "object",
  "required": [
    "schema_version",
    "run_id",
    "scenario_id",
    "tick",
    "calendar_date",
    "economy_id",
    "phase_id",
    "phase_code",
    "phase_ordinal",
    "snapshot_epoch",
    "entity_counts",
    "contract_counts",
    "posting_digest",
    "event_digest",
    "physical_command_digest",
    "selected_state",
    "invariant_results",
    "rng_metadata",
    "terminal_status"
  ],
  "properties": {
    "schema_version": {"const": "phase-trace-v1"},
    "run_id": {"type": "string", "minLength": 1},
    "scenario_id": {"type": "string", "minLength": 1},
    "tick": {"type": "integer", "minimum": 0},
    "calendar_date": {"type": ["string", "null"], "format": "date"},
    "economy_id": {"type": ["integer", "null"], "minimum": 0},
    "phase_id": {"type": "string"},
    "phase_code": {"type": "string"},
    "phase_ordinal": {"type": "integer", "minimum": 0},
    "snapshot_epoch": {"type": "string"},
    "entity_counts": {"type": "object"},
    "contract_counts": {"type": "object"},
    "posting_digest": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "event_digest": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "physical_command_digest": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "selected_state": {"type": "object"},
    "invariant_results": {"type": "array"},
    "rng_metadata": {"type": "object"},
    "terminal_status": {"enum": ["ok", "failed", "terminal"]}
  },
  "additionalProperties": false
}
