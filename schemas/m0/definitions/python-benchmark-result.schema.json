{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://macro-simulator.local/schemas/m0/python-benchmark-result.schema.json",
  "title": "M0 Python benchmark result",
  "type": "object",
  "required": [
    "schema_version",
    "scenario_schema_version",
    "scenario_id",
    "repository",
    "contract_sha256",
    "captured_at_utc",
    "environment",
    "command",
    "process_count",
    "thread_count",
    "warmup_ticks",
    "repetitions",
    "raw_samples_ns",
    "statistics_ns",
    "workload_counters",
    "semantic_result_digest",
    "invariant_status"
  ],
  "properties": {
    "schema_version": {"const": "python-benchmark-result-v1"},
    "scenario_schema_version": {"const": "python-benchmark-scenarios-v1"},
    "scenario_id": {"type": "string"},
    "repository": {"type": "object"},
    "contract_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "captured_at_utc": {"type": "string"},
    "environment": {"type": "object"},
    "command": {"type": "array"},
    "process_count": {"type": "integer", "minimum": 1},
    "thread_count": {"type": "integer", "minimum": 1},
    "warmup_ticks": {"type": "integer", "minimum": 0},
    "repetitions": {"type": "integer", "minimum": 1},
    "raw_samples_ns": {"type": "object"},
    "statistics_ns": {"type": "object"},
    "workload_counters": {"type": "object"},
    "semantic_result_digest": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "invariant_status": {"enum": ["passed", "failed"]},
    "peak_rss_bytes": {"type": ["integer", "null"]},
    "scenario_contract_sha256": {"type": "string"},
    "dependency_lock_sha256": {"type": ["string", "null"]}
  },
  "additionalProperties": false
}
