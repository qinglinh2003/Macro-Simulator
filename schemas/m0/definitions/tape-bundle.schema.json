{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://macro-simulator.local/schemas/m0/tape-bundle.schema.json",
  "title": "M0 policy, shock, action, and realization tape bundle",
  "type": "object",
  "required": ["schema_version", "calendar_start", "policy", "shock", "action", "realization"],
  "properties": {
    "schema_version": {"const": "m0-tape-source-v1"},
    "calendar_start": {"type": "string", "format": "date"},
    "policy": {"type": "array", "minItems": 5},
    "shock": {"type": "object"},
    "action": {"type": "array", "minItems": 1},
    "realization": {"type": "array", "minItems": 1}
  },
  "additionalProperties": false
}
